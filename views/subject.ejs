<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Subject</title>
<style>
  body 
  {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f5f5;
  }
  .content 
  {
    margin-left: 200px;
    padding: 40px;
    display: flex;
    gap: 20px;
    /* margin-top: -360px; */
    align-items: flex-start; 
  }
  .left-box 
  {
    background-color: white;
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
    flex: 1;
    min-width: 400px;
   }
  .course-table {
    width: 100%;
    border-collapse: collapse;
    font-family: Arial, sans-serif;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    margin-top: 20px;
}

.course-table thead {
    background-color: #343a40;
    color: white;
}

.course-table th,
.course-table td {
    padding: 12px 15px;
    border: 1px solid #ddd;
    text-align: left;
}

.course-table tbody tr:nth-child(even) {
    background-color: #f9f9f9;
}

.course-table tbody tr:hover {
    background-color: #f1f1f1;
}

.course-table a {
    font-weight: bold;
    text-decoration: none;
}

.course-table .delete-link {
    color: #dc3545;
}

  .right-box 
  {
    background-color: white;
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
    min-width: 400px;
    width: 350px;
    flex-shrink: 0; 
  }
  .add-course-form input[type="text"] 
  {
    width: 80%;
    padding: 10px;
    margin: 10px 0 10px 0;
    margin-right: 5px;
    border-radius: 5px;
    border: 1px solid #ccc;
  }
  .delete-link 
  {
    text-decoration: none;
    font-weight: bold;
    cursor: pointer;
    color: #dc3545;
  }
  .add-course-form button{
    background-color: #ffc107;
    color: black;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
  }
  #pagination 
        {
            text-align: center;
            margin-top: 20px;
        }
        .page-btn 
        {
            padding: 8px 12px;
            margin: 0 5px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }  
        .page-btn.active 
        {
            background-color: #0056b3;
        }
        .page-btn:hover:not(:disabled) 
        {
            background-color: #0056b3;
        }
        .page-btn:disabled 
        {
            background-color: #ccc;
            cursor: not-allowed;
        }
  </style>
</head>
<body>
    <%- include("dashboard.ejs") %>
    <div class="content">
    <div class="left-box">
    <h2>Existing Courses</h2>
<table class="course-table" id="course">
  <thead>
    <tr>
      <th>ID</th>
      <th>Course</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% subjects.forEach(course => { %>
      <tr>
        <td><%= course.cid %></td>
        <td><%= course.cname %></td>
        <td>
          <a href="/deletecourse/<%= course.cid %>" class="delete-link">Delete</a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<!-- jQuery CDN -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<div id="pagination"></div>
<!-- Pagination Script -->
<script>
$(document).ready(function () {
    const rowsPerPage = 5;
    const rows = $('#course tbody tr');
    const rowsCount = rows.length;
    const pageCount = Math.ceil(rowsCount / rowsPerPage);
    let currentPage = 1;

    function renderPagination() {
        $('#pagination').empty();

        if (pageCount > 1) {
            $('#pagination').append(`<button class="page-btn prev-btn" ${currentPage === 1 ? 'disabled' : ''}>Prev</button>`);

            for (let i = 1; i <= pageCount; i++) {
                $('#pagination').append(`<button class="page-btn num-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`);
            }

            $('#pagination').append(`<button class="page-btn next-btn" ${currentPage === pageCount ? 'disabled' : ''}>Next</button>`);
        }
    }

    function showPage(page) {
        currentPage = page;

        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        rows.hide();
        rows.slice(start, end).show();

        renderPagination();
    }

    // Initial render
    showPage(currentPage);

    // Click handlers
    $('#pagination').on('click', '.num-btn', function () {
        const pageNum = parseInt($(this).data('page'));
        showPage(pageNum);
    });

    $('#pagination').on('click', '.prev-btn', function () {
        if (currentPage > 1) showPage(currentPage - 1);
    });

    $('#pagination').on('click', '.next-btn', function () {
        if (currentPage < pageCount) showPage(currentPage + 1);
    });
});
</script>
  </div>
      <div class="box add-course-form right-box">
        <h2 style="color: black">Add New Course</h2>
        <form method="POST" action="/addcourse">
          <label>Course Name</label>
          <input type="text" name="cname" placeholder="Enter course name" required />
          <button type="submit">Add Course</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
