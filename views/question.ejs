<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Question</title>
    <style>
        body 
        {
            font-family: Arial, sans-serif;
            margin: 20px;
            background: #edf2f7;
            color: #333;
        }
        .contain 
        {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 10px;
            margin-top: 27px;
            margin-left: 230px;
            gap: 20px;
        }
        .contain h3
        {
            text-align: center;
        }
        form 
        {
            flex: 1;
            padding: 20px;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
            height: auto;
            max-width: 500px;
        }
        table 
        {
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 6px #0003;
            margin-top: 0;
            margin-left: 0;
            width:600px;
        }
        form div 
        {
            margin-bottom: 2.5px;
        }
        label 
        {
            display: block;
            font-weight: bold;
            color: #4a5568;
        }
        input 
        {
            width: 93%;
            padding: 5px;
            border: 1px solid #cbd5e0;
            border-radius: 6px;
            background: #edf2f7;
        }
       .input-style 
       {
            width: 91%;
            padding: 0px;
            border-radius: 10px;
            border: none;
            background-color: #cde1f9;
            font-size: 16px;
            margin-bottom: 10px;
            margin-left: 27px;
            resize: vertical; 
        }
        button 
        {
            padding: 10px 20px;
            background-color: #ffc107;
            color: black;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }
        button:hover 
        {
            background: #2b6cb0;
        }
        .center-select {
    display: flex;
    flex-direction: column;
    align-items:start;
    margin-top: 8px;
    margin-bottom: 15px;
}

.center-select label {
    font-weight: bold;
    color: #4a5568;
    margin-bottom: 5px;
}

.center-select select {
    /* margin-right: 11px; */
    margin-left: 71px;
    width: 66%;
    padding: 6px;
    border: 1px solid #cbd5e0;
    border-radius: 6px;
    background-color: #edf2f7;
    font-size: 16px;
}

        .quest
        {
            flex: 1;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
            padding: 20px;
        }
        .question-table 
        {
            width: 100%;
            border-collapse: collapse;
            font-family: Arial, sans-serif;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            margin-top: 20px;
        }
        .question-table thead 
        {
            background-color: #343a40;
            color: white;
        }
        .question-table th,
        .question-table td 
        {
            padding: 12px 15px;
            border: 1px solid #ddd;
            text-align: left;
        }
        .question-table tbody tr:nth-child(even) 
        {
            background-color: #f9f9f9;
        }
        .question-table tbody tr:hover 
        {
            background-color: #f1f1f1;
        }
        .question-table a 
        {
            font-weight: bold;
            text-decoration: none;
        }
        .question-table .delete-link 
        {
            color: #dc3545;
        }
        #pagination 
        {
            text-align: center;
            margin-top: 20px;
        }
        .page-btn 
        {
            padding: 8px 12px;
            margin: 0 5px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }  
        .page-btn.active 
        {
            background-color: #0056b3;
        }
        .page-btn:hover:not(:disabled) 
        {
            background-color: #0056b3;
        }
        .page-btn:disabled 
        {
            background-color: #ccc;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <%- include("dashboard.ejs") %>
    <div class="contain">
        <form action="/questions/add" method="POST">
            <h2>Add New Question</h2>
            <div>
                <label>Question</label>
                <textarea name="qname" class="input-style" rows="3" placeholder="enter question" required></textarea>
            </div>
            <div>
                <label>Option 1</label>
                <input type="text" name="op1" required>
            </div>
            <div>
                <label>Option 2</label>
                <input type="text" name="op2" required>
            </div>
            <div>
                <label>Option 3</label>
                <input type="text" name="op3" required>
            </div>
            <div>
                <label>Option 4</label>
                <input type="text" name="op4" required>
            </div>
            <div>
                <label>Correct Answer (Option Number)</label>
                <input type="number" name="answer" min="1" max="4" placeholder="enter correct answer option" required>
            </div>
            <div class="center-select">
            <label>Select Course</label>
            <select name="course_id">
                <% subjects.forEach(course => { %>
                    <option value="<%= course.cid %>"><%= course.cname %></option>
                <% }); %>
            </select>
            </div>
            <button type="submit">Save Question</button>
        </form>
        <div class="quest">
        <h2>Question List</h2>
            <table class="question-table" id="question">
  <thead>
    <tr>
      <th>#</th>
      <th>Question</th>
      <th>Answer</th>
      <th>Course</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% questions.forEach((question, index) => { %>
    <tr>
      <td><%= index+1 %></td>
      <td>
      <strong><%= question.qname %></strong><br>
        1. <%= question.op1 %> 
        2. <%= question.op2 %> 
        3. <%= question.op3 %> 
        4. <%= question.op4 %>
      </td>
      <td><%= question.answer %></td>
      <td><%= question.cname %></td>
      <td>
        <a href="/questions/delete/<%= question.qid %>" class="delete-link">Delete</a>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>

            <!-- jQuery CDN -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<div id="pagination"></div>
<!-- Pagination Script -->
<script>
$(document).ready(function () {
    const rowsPerPage = 3;
    const rows = $('#question tbody tr');
    const rowsCount = rows.length;
    const pageCount = Math.ceil(rowsCount / rowsPerPage);
    let currentPage = 1;

    function renderPagination() {
        $('#pagination').empty();

        if (pageCount > 1) {
            $('#pagination').append(`<button class="page-btn prev-btn" ${currentPage === 1 ? 'disabled' : ''}>Prev</button>`);

            for (let i = 1; i <= pageCount; i++) {
                $('#pagination').append(`<button class="page-btn num-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`);
            }

            $('#pagination').append(`<button class="page-btn next-btn" ${currentPage === pageCount ? 'disabled' : ''}>Next</button>`);
        }
    }

    function showPage(page) {
        currentPage = page;

        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        rows.hide();
        rows.slice(start, end).show();

        renderPagination();
    }

    // Initial render
    showPage(currentPage);

    // Click handlers
    $('#pagination').on('click', '.num-btn', function () {
        const pageNum = parseInt($(this).data('page'));
        showPage(pageNum);
    });

    $('#pagination').on('click', '.prev-btn', function () {
        if (currentPage > 1) showPage(currentPage - 1);
    });

    $('#pagination').on('click', '.next-btn', function () {
        if (currentPage < pageCount) showPage(currentPage + 1);
    });
});
</script>
        </div>
    </div>
</body>
</html>
