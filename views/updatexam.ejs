<!DOCTYPE html>
<html>
<head>
    <title>Update Exam</title>
        
    <style>
        body {
            background-image: url("/laptop.jpeg");
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            margin: 0;
            padding: 0;
            width: 200vh;
            height:55vh;
        }
        h1 {
            text-align: center;
            color: #333;
            background-color: #ccc;
            border-radius: 8px;
            padding-left: 30px;
            margin-left: 50px;
        }
        form {
            background: #fff;
            padding: 30px;
            border-radius: 8px;
            max-width: 600px;
            margin: auto;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        label {
            display: block;
            margin-top: 10px;
        }
        input {
            padding: 8px;
            width: 100%;
            margin-top: 6px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        button {
            margin-top: 20px;
            background: #28a745;
            color: white;
            padding: 10px 18px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        a {
            display: block;
            margin-top: 20px;
            text-align: center;
            color: #007bff;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <h1>Update Exam</h1>
    <form action="/updateExam/<%= exam.ex_id %>" method="POST">
        <label>Exam Name:</label>
        <input type="text" name="exname" value="<%= exam.exname %>" required>

        <label>Total Marks:</label>
        <input type="number" name="totalmark" value="<%= exam.totalmark %>" required>

        <label>Passing Marks:</label>
        <input type="number" name="passingmark" value="<%= exam.passingmark %>" required>

        <button type="submit">Update Exam</button>
    </form>
    <a href="/exam">← Back to Exam List</a>
</body>
</html>
