<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Schedule</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body {
      background-image: url("/laptop.jpeg");
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center;
      font-family: Arial, sans-serif;
      padding: 0;
      width: 200vh;
      height:55vh;
    }
    .content {
      margin: 37px;
      display: flex;
      gap: 20px;
      margin-left: 240px;
      align-items: flex-start;
    }

    .left-box, .right-box {
      background-color: white;
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    .left-box {
      width: 380px;
      flex-shrink: 0;
    }
    .right-box {
      flex: 1.5;
      width: 700px;
    }
    h3 {
      color: #333;
      margin-top: 0;
      text-align: center;
    }
    input, select {
      width: 95%;
      padding: 10px;
      margin: 10px 0;
      border-radius: 5px;
      border: 1px solid #ccc;
    }
    button {
      background-color: #ffc107;
      color: black;
      border: none;
      padding: 10px 20px;
      border-radius: 5px;
      font-weight: bold;
      cursor: pointer;
    }
    .update-link,
    .delete-link 
    {
      text-decoration: none;
      font-weight: bold;
      cursor: pointer;
    }
    .update-link 
    {
      color: #007bff;
    }
    .delete-link 
    {
      color: #dc3545;
    }
    .styled-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      font-size: 16px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    .styled-table thead tr {
      background-color: #343a40;
      color: #ffffff;
      text-align: left;
    }
    .styled-table th,
    .styled-table td {
      padding: 12px 15px;
      border: 1px solid #ddd;
    }
    .styled-table tbody tr {
      background-color: #f9f9f9;
    }
    .styled-table tbody tr:hover {
      background-color: #f1f1f1;
    }
     #pagination {
      text-align: center;
      margin-top: 20px;
    }
    .page-btn {
      padding: 8px 12px;
      margin: 0 5px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
    }
    .page-btn.active {
      background-color: #0056b3;
    }
    .page-btn:hover:not(:disabled) {
      background-color: #0056b3;
    }
    .page-btn:disabled {
      background-color: #ccc;
      cursor: not-allowed;
    }
  </style>
</head>
<body>
    <%- include('dashboard') %>
  <div class="content">
    <!-- LEFT: Add New Schedule Form -->
    <div class="left-box">
      <h2>Add New Schedule</h2>
      <form action="/schedule/add" method="POST">
        <label>Date:</label>
        <input type="date" name="date" required>

        <label>Start Time:</label>
        <input type="time" name="starttime" required>

        <label>End Time:</label>
        <input type="time" name="endtime" required>

        <label>Course:</label>
        <select name="cid" required>
          <option value="">--Select Course--</option>
          <% subjects.forEach(course => { %>
            <option value="<%= course.cid %>"><%= course.cname %></option>
          <% }) %>
        </select>

        <label>Exam:</label>
        <select name="ex_id" required>
          <option value="">--Select Exam--</option>
          <% exams.forEach(exam => { %>
            <option value="<%= exam.ex_id %>"><%= exam.exname %></option>
          <% }) %>
        </select>

        <button type="submit">Add Schedule</button>
      </form>
    </div>

    <!-- RIGHT: Schedule List -->
    <div class="right-box">
      <h2>Schedule List</h2>
      <table class="styled-table" id="schedule">
        <thead>
          <tr>
            <th>#</th>
            <th>Date</th>
            <th>Start</th>
            <th>End</th>
            <th>Course</th>
            <th>Exam</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% schedules.forEach((s, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
               <td><%= new Date(s.date).toISOString().split('T')[0] %></td>
              <td><%= s.starttime %></td>
              <td><%= s.endtime %></td>
              <td><%= s.cname %></td>
              <td><%= s.exname %></td>
              <td>
                <a href="/schedule/edit/<%= s.schid %>" class="update-link">Update</a>
                <a href="/schedule/delete/<%= s.schid %>" class="delete-link" onclick="return confirm('Are you sure?')">Delete</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <!-- jQuery CDN -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<div id="pagination"></div>
<!-- Pagination Script -->
<script>
$(document).ready(function () {
    const rowsPerPage = 3;
    const rows = $('#schedule tbody tr');
    const rowsCount = rows.length;
    const pageCount = Math.ceil(rowsCount / rowsPerPage);
    let currentPage = 1;

    function renderPagination() {
        $('#pagination').empty();

        if (pageCount > 1) {
            $('#pagination').append(`<button class="page-btn prev-btn" ${currentPage === 1 ? 'disabled' : ''}>Prev</button>`);

            for (let i = 1; i <= pageCount; i++) {
                $('#pagination').append(`<button class="page-btn num-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`);
            }

            $('#pagination').append(`<button class="page-btn next-btn" ${currentPage === pageCount ? 'disabled' : ''}>Next</button>`);
        }
    }

    function showPage(page) {
        currentPage = page;

        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        rows.hide();
        rows.slice(start, end).show();

        renderPagination();
    }

    // Initial render
    showPage(currentPage);

    // Click handlers
    $('#pagination').on('click', '.num-btn', function () {
        const pageNum = parseInt($(this).data('page'));
        showPage(pageNum);
    });

    $('#pagination').on('click', '.prev-btn', function () {
        if (currentPage > 1) showPage(currentPage - 1);
    });

    $('#pagination').on('click', '.next-btn', function () {
        if (currentPage < pageCount) showPage(currentPage + 1);
    });
});
</script>
    </div>
  </div>
</body>
</html>
